{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Proyecto Finanzas",
        "description": "Documentación de la API REST para el Laboratorio 5",
        "version": "1.0.0"
    },
    "paths": {
        "/api/transactions": {
            "get": {
                "tags": ["Transacciones"],
                "summary": "Listar transacciones",
                "description": "Devuelve una lista paginada de las transacciones del usuario autenticado.",
                "operationId": "6581469356772e7a74a0d79897544f1a",
                "responses": {
                    "200": {
                        "description": "Listado obtenido correctamente."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": ["Transacciones"],
                "summary": "Crear nueva transacción",
                "description": "Registra una nueva transacción.",
                "operationId": "ab765dced58cfe2f620929db31452145",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "account_id",
                                    "category_id",
                                    "amount",
                                    "transaction_date"
                                ],
                                "properties": {
                                    "account_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "amount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 150.5
                                    },
                                    "transaction_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-15"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Compra de supermercado"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Transacción creada exitosamente"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "tags": [
        {
            "name": "Transacciones",
            "description": "Transacciones"
        }
    ]
}
